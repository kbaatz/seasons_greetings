-- ★ main menu ★
--for star feild 
local stars = {}
for i = 1, 30 do
	add(stars, {
			x = flr(rnd(128)),
			y = flr(rnd(128)),
			speed = rnd(1.0) + 0.3
			})
end 

function draw_menu()
	cls(1)
	draw_starfield()
	sspr(64,66,48,24,19,20, 98, 48)
	--flash 
	if time() % 2 > 0.5	then 
		print("press ❎ to start",30,85) 
	end
end 

function draw_starfield()
	for s in all(stars) do 
		s.y += s.speed
		
		if s.y > 128 then 
			s.y = 0 
			s.x = flr(rnd(128))
		end
		
		local col = 7
		pset(s.x, s.y, col)
	end
end 

function update_menu()
	if btnp(❎) then 
			scene = "game"
	end
end

