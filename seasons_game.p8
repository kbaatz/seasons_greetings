__lua__

--variables
--initialisation
function _init()
	--state machine 
	--helpful for changing scenes too
	scene="menu"
	music(0)

	--pal(0, 12, 1)
	pl={
		sp=1,
		x=59,
		y=59,
		w=8,
		h=8,
		flp=false,
		dx=0,
		dy=0,
		max_dx=2,
		max_dy=3,
		acc=0.5,
		jmp=4,
		running=false,
		sliding=false,
		falling=false,
		landed=true,
		anim=0
	}
	
	col={12,12,1,1}
	gravity=0.3
	friction=0.85
	screen=0
	ducks = 0

	--for the sparkles
	sparkle=false
	exps={}
	clrs={7,10,11,14}
	exp_x=0
	exp_y=0
	
	--pop up mene
	menu_open=false
	menu_choice=1
	music_on=true
	
	--saving code 
	cartdata("duck_game")

	-- load saved duck count
	ducks=dget(0)
	
	--credits 
	credits_y=140
	
	--enemies
	enem = {}
	spawn_enemies()
	
	--lives
	lives=4

end



-->8
--game
function update_game()

	if menu_open then
		-- menu already open
		update_pop_menu()

	else
		-- normal game
		player_update()
		player_animate()

		-- z opens menu
		if btnp(🅾️) then
			menu_open=true
		end
	end
end

--draw stuff
function draw_game()
	camera(128*screen,0)
	cls(col[screen+1])
	
	map(0,16,0x8)
	map(0,0)
	
	
	spr(pl.sp,
	    pl.x,
	    pl.y,
	    pl.w/8,
	    pl.h/8,
	
	    pl.flp)
	    
 draw_ui()
 
 if menu_open then
		draw_pop_menu()
	end

end



-->8
--collisions
function collide_map(obj, aim, flag)
	--obj = table needing x, y, w, x
	local x=obj.x local y=obj.y
	local w=obj.w-1.5 local h=obj.h		
	local x1=0 local y1=0
	local x2=0 local y2=0
	
	if aim=="left" then
		x1=x-1 y1=y
		x2=x			y2=y+h-1
	
	elseif aim=="right" then
		x1=x+w y1=y
		x2=x			y2=y+h-1
	
	elseif aim=="up" then
		x1=x+1 y1=y-1
		x2=x+w-1			y2=y
	
	elseif aim=="down" then
		x1=x y1=y+h
		x2=x+w			y2=y+h
	end
	
	--pixels to tiles
	x1/=8 y1/=8
	x2/=8 y2/=8
	
	if fget(mget(x1, y1), flag)
	or fget(mget(x1, y2), flag)
	or fget(mget(x2, y1), flag)
	or fget(mget(x2, y2), flag) then
		return true
	else
		return false
	end
	
end


function clear_tile(pl)
	-- get the tile coords
	local tx = flr(pl.x/8)
	local ty = flr(pl.y/8)
	local targx, targy
	
	if collide_map(pl,"down",4) then
		targx, targy = tx, ty+1
	elseif collide_map(pl,"right",4) then
		targx, targy = tx+1, ty
	elseif collide_map(pl,"left",4) then
		targx, targy = tx-1, ty
	end
	
	if fget(mget(targx,targy),4) then
		mset(targx,targy,0)
		exp_x=pl.x-128*screen
		exp_y=pl.y
		clrs={8,10,11,14}
		sparkle=true
	end
end
	


-->8
--player

function player_update()
	--physics
	pl.dy+=gravity
	pl.dx*=friction
	
	if btn(⬅️) then
		pl.dx-=pl.acc
		pl.running=true
		pl.flp=true
	end
	
	if btn(➡️) then
		pl.dx+=pl.acc
		pl.running=true
		pl.flp=false
	end
	
	--slide
	if pl.running
	and not btn(⬅️)
	and not btn(➡️)
	and not pl.falling
	and not pl.jumping then
		pl.running=false
		pl.sliding=true
	end
	
	--jump
	if btnp(⬆️)
	and pl.landed then
		pl.dy-=pl.jmp
		pl.landed=false
		
		sfx(4) 
	end
	
	--check col on up and down
	
	if pl.dy>0 then
		pl.falling=true
		pl.landed=false
		pl.jumping=false
		
		pl.dy=limit_speed(pl.dy, pl.max_dy)
		
		if collide_map(pl, "down", 0) then
			pl.landed=true
			pl.falling=false
			pl.dy=0
			pl.y-=(pl.y + pl.h)%8		
		end
	elseif pl.dy < 0 then
		pl.jumping=true
		if collide_map(pl,"up",1) then
			pl.dy=0
		end
	end
	
	--check left and right
	if pl.dx < 0 then
		pl.dx=limit_speed(pl.dx, pl.max_dx)
	
		if collide_map(pl,"left",0) then
			pl.dx=0
		end
		
	elseif pl.dx > 0 then
		pl.dx=limit_speed(pl.dx, pl.max_dx)
		if collide_map(pl,"right",0) then
			pl.dx=0
		end	
	end
	
	
	--stop sliding
	if pl.sliding then
		if abs(pl.dx)< .2
		or pl.running then 
			pl.dx=0
			pl.sliding=false
		end
	end
	
	-- transition
	if collide_map(pl,"right",2) 
	and screen < 5 then --3 is an arbit limit to make sure the player does not go into a random empty room
		screen+=1
		pl.dx=0
		pl.x=screen*128 +1
		pl.y=59
	end
	
	--stop from running off screen
	if pl.x+pl.w-1>(screen*128+128) then 
		pl.x=screen*128+128-pl.w
	end
	
	if pl.x<screen*128 then
		pl.x=screen*128
	end
	
	--deletes a disapearing tile
	clear_tile(pl)

	--slippery tile
	if collide_map(pl,"down",5) then
		friction=0.99
	else
		friction=0.85
	end

	
	pl.x+=pl.dx
	pl.y+=pl.dy
	
	collect_duck()
end


function player_animate()
	if pl.jumping then
		pl.sp=7
	elseif pl.falling then
		pl.sp=8
	elseif pl.sliding then
		pl.sp=9
	elseif pl.running then
		if time()-pl.anim>0.1 then
			pl.anim=time()
			pl.sp+=1
			if pl.sp>6 then
				pl.sp=3
			end
		end
	else --pl idle
		if time()-pl.anim>.3 then
			pl.anim=time()
			pl.sp+=1
			if pl.sp>2 then
				pl.sp=1
			end
		end
	end
	
end

function limit_speed(num, maximum)
	return mid(-maximum, num, maximum)
end

--duck collecting
	function collect_duck()
		-- find the map tiles the player overlaps
		local x1=flr(pl.x/8)
		local x2=flr((pl.x+pl.w-1)/8)
	
		local y1=flr(pl.y/8)
		local y2=flr((pl.y+pl.h-1)/8)
	
		-- check each overlapping tile
		for x=x1,x2 do
			for y=y1,y2 do
	
				-- if this tile has duck flag 6
				if fget(mget(x,y),6) then
	
					ducks+=1      
					mset(x,y,0) 
					sfx(5)
					
					--add a sparkle
					clrs={8,2,9,10}
					exp_x=pl.x-128*screen
					exp_y=pl.y
					sparkle=true
	
				end
			end
		end
	end
