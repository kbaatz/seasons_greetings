-- credits
function update_credits()
	cls(1)
	draw_starfield()
	credits_y-=0.5

	-- go back
	if btnp(🅾️) then
		scene="game"
		menu_open=true
	end

end 

function draw_credits()
	camera(0,0)
	cls(1)

	draw_starfield()
	-- title
	centre_text("credits",credits_y,7)

	-- names
	centre_text("game by",credits_y+20,7)
	centre_text("ksenia, lucas and gemma",credits_y+28,7)

	centre_text("code by",credits_y+43,6)
	centre_text("ksenia, lucas and gemma",credits_y+51,6)
	centre_text("(and many youtube videos)",credits_y+59,6)

	centre_text("art by ksenia",credits_y+74,6)
	centre_text("title by gemma",credits_y+82,6)

	centre_text("music by gemma",credits_y+97,6)

	-- thank you
	centre_text("thanks for playing!",credits_y+117,7)

	-- duck
	spr(20,60,credits_y+135)
	
	rectfill(20,116,108,127,1)
	centre_text("press z to go back",120,7)
end

function centre_text(txt,y,col)
	local x=64-(#txt*2)
	print(txt,x,y,col)
end
-->8
--enemies

function update_enem()
	for e in all(enem) do
	-- direction of bird
		if e.ex>e.ox+e.er then
			e.dir=false
		elseif e.ex<e.ox-e.er then
			e.dir=true
		end
		
		if e.dir then
			e.ex+=.1
		else
			e.ex-=.1
		end	
		
			--check with player col
		if pl_enem_collide(e) then
			lives-=1
			del(enem,e)
			sfx(4) 	
		end 
		
	end
end

function pl_enem_collide(e)
	return pl.x < e.ex+8 and pl.x+pl.w > e.ex
		and pl.y < e.ey+8 and pl.y+pl.h > e.ey
end

function draw_enem()
	for e in all(enem) do
		if e.screen==screen then
			spr(e.sp,e.ex-screen*128,e.ey,1,1,not e.dir)
		end	
	end
end


function spawn_enemies()
	for x=0,63 do --loop through screen
		for y=0,15 do
		--lev1
			if mget(x,y)==21 then
				add(enem,{
					ex=x*8,
					ey=y*8,
					er=10,
					ox=x*8,
					dir=true,
					screen=0,
					sp=21
				})
			mset(x,y,0)
			end
			
			--lev2
			if mget(x,y)==22 then
				add(enem,{
					ex=x*8,
					ey=y*8,
					er=10,
					ox=x*8,
					dir=true,
					screen=1,
					sp=22
				})
			mset(x,y,0)
			end
			
			--lev3
			if mget(x,y)==23 then
				add(enem,{
					ex=x*8,
					ey=y*8,
					er=5,
					ox=x*8,
					dir=true,
					screen=2,
					sp=23
				})
			mset(x,y,0)
			end
			
			--lev4
			if mget(x,y)==24 then
				add(enem,{
					ex=x*8,
					ey=y*8,
					er=7,
					ox=x*8,
					dir=true,
					screen=3,
					sp=24
				})
			mset(x,y,0)
			end
			
		end
	end
end
