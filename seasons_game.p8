pico-8 cartridge // http://www.pico-8.com
version 43
__lua__

--variables
--initialisation
function _init()
	--state machine 
	--helpful for changing scenes too
	scene="menu"

	pal(0, 12, 1)
	pl={
		sp=1,
		x=59,
		y=59,
		w=8,
		h=8,
		flp=false,
		dx=0,
		dy=0,
		max_dx=2,
		max_dy=3,
		acc=0.5,
		jmp=4,
		running=false,
		sliding=false,
		falling=false,
		landed=true,
		anim=0
	}
	
	col={12,1,3}
	gravity=0.3
	friction=0.85
	screen=0

end



-->8
--game
function update_game()
	player_update()
	player_animate()
	
	
end

--draw stuff
function draw_game()
	camera(128*screen,0)
	cls(col[screen+1])
	map(0,16,0x8)
	map(0,0)
	
	
	spr(pl.sp,
	    pl.x,
	    pl.y,
	    pl.w/8,
	    pl.h/8,
	
	    pl.flp)

end



-->8
--collisions
function collide_map(obj, aim, flag)
	--obj = table needing x, y, w, x
	local x=obj.x local y=obj.y
	local w=obj.w-2 local h=obj.h		
	local x1=0 local y1=0
	local x2=0 local y2=0
	
	if aim=="left" then
		x1=x-1 y1=y
		x2=x			y2=y+h-1
	
	elseif aim=="right" then
		x1=x+w y1=y
		x2=x			y2=y+h-1
	
	elseif aim=="up" then
		x1=x+1 y1=y-1
		x2=x+w-1			y2=y
	
	elseif aim=="down" then
		x1=x y1=y+h
		x2=x+w			y2=y+h
	end
	
	--pixels to tiles
	x1/=8 y1/=8
	x2/=8 y2/=8
	
	if fget(mget(x1, y1), flag)
	or fget(mget(x1, y2), flag)
	or fget(mget(x2, y1), flag)
	or fget(mget(x2, y2), flag) then
		return true
	else
		return false
	end
	
end
-->8
--player

function player_update()
	--physics
	pl.dy+=gravity
	pl.dx*=friction
	
	if btn(⬅️) then
		pl.dx-=pl.acc
		pl.running=true
		pl.flp=true
	end
	
	if btn(➡️) then
		pl.dx+=pl.acc
		pl.running=true
		pl.flp=false
	end
	
	--slide
	if pl.running
	and not btn(⬅️)
	and not btn(➡️)
	and not pl.falling
	and not pl.jumping then
		pl.running=false
		pl.sliding=true
	end
	
	--jump
	if btnp(⬆️)
	and pl.landed then
		pl.dy-=pl.jmp
		pl.landed=false
	end
	
	--check col on up and down
	
	if pl.dy>0 then
		pl.falling=true
		pl.landed=false
		pl.jumping=false
		
		pl.dy=limit_speed(pl.dy, pl.max_dy)
		
		if collide_map(pl, "down", 0) then
			pl.landed=true
			pl.falling=false
			pl.dy=0
			pl.y-=(pl.y + pl.h)%8		
		end
	elseif pl.dy < 0 then
		pl.jumping=true
		if collide_map(pl,"up",1) then
			pl.dy=0
		end
	end
	
	--check left and right
	if pl.dx < 0 then
		pl.dx=limit_speed(pl.dx, pl.max_dx)
	
		if collide_map(pl,"left",0) then
			pl.dx=0
		end
		
	elseif pl.dx > 0 then
		pl.dx=limit_speed(pl.dx, pl.max_dx)
		if collide_map(pl,"right",0) then
			pl.dx=0
		end	
	end
	
	
	--stop sliding
	if pl.sliding then
		if abs(pl.dx)< .2
		or pl.running then 
			pl.dx=0
			pl.sliding=false
		end
	end
	
	-- transition
	if collide_map(pl,"right",2) 
	and screen < 3 then --3 is an arbit limit to make sure the player does not go into a random empty room
		screen+=1
		pl.dx=0
		pl.x+=128
		pl.y=59
	end
	
	--stop from running off screen
	if pl.x+pl.w-1>(screen*128+128) and btn(➡️) then 
		pl.dx=0
	end
	
	if pl.x<screen*128 and btn(⬅️) then
		pl.dx=0
	end
	
	pl.x+=pl.dx
	pl.y+=pl.dy

end

function player_animate()
	if pl.jumping then
		pl.sp=7
	elseif pl.falling then
		pl.sp=8
	elseif pl.sliding then
		pl.sp=9
	elseif pl.running then
		if time()-pl.anim>0.1 then
			pl.anim=time()
			pl.sp+=1
			if pl.sp>6 then
				pl.sp=3
			end
		end
	else --pl idle
		if time()-pl.anim>.3 then
			pl.anim=time()
			pl.sp+=1
			if pl.sp>2 then
				pl.sp=1
			end
		end
	end
	
end

function limit_speed(num, maximum)
	return mid(-maximum, num, maximum)
end
