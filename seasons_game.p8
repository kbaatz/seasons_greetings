--main update and draw game

function _update()

	if scene == "menu" then 
			update_menu()
	elseif scene=="credits" then
		update_credits()
	elseif lives==0 then
		update_credits() --temp
	elseif screen==4 then
		draw_credits()
	else 
			update_game()
			update_enem()
			update_exp()
	end

end

function _draw()

	if scene == "menu" then 
			draw_menu()
	elseif scene=="credits" then
		draw_credits()
	elseif lives==0 then
		draw_credits() --temp
	elseif screen==4 then
		draw_credits()
	else 
		draw_game()
		draw_enem()
		draw_exp()
	end

end
-->8
-- explosions
	
function update_exp()
	for p in all(exps) do
		p.x+=p.spdx
		p.y+=p.spdy
		p.scale-=.1
		p.l-=.1
		p.c=flr(p.l)
		if p.l<=0 then del(exps,p) end
	end
	
	if sparkle then
	for i=0,20 do
		add(exps,{
			x=exp_x,
			y=exp_y,
			spdx=1-rnd(2),
			spdy=1-rnd(2),
			scale=0.2+rnd(2),
			l=5
			})
	end
	sparkle=false
	--add spfx
	end
end


function draw_exp()
	for p in all(exps) do
		circfill(p.x,p.y,p.scale,clrs[p.c])
	end
end
		
